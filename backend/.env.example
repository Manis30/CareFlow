PORT=5000
DB_URL=mongodb://localhost:27017/careflow
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Model Keys & Fallbacks
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key

# Transactional Email Config
EMAIL_API_KEY=your_email_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM_ADDRESS=noreply@careflow.health

# WebRTC Video Consultation TURN Server Config
TURN_URL=turn:numb.viagenie.ca
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# Error Monitoring Config
SENTRY_DSN=your_sentry_dsn_here

# Bot Protection Config
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
